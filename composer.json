{
	"name": "soderlind/loupe-search-addons",
	"description": "Install, activate and update Loupe Search add-ons from GitHub.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.3",
		"soderlind/wordpress-github-updater": "^2.0",
		"yahnis-elsts/plugin-update-checker": "^5.6"
	},
	"require-dev": {
		"phpunit/phpunit": "^12",
		"brain/monkey": "^2.6"
	},
	"autoload-dev": {
		"psr-4": {
			"Soderlind\\Plugin\\LoupeSearchAddons\\": "includes/",
			"Soderlind\\Plugin\\LoupeSearchAddons\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"platform": {
			"php": "8.3.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"test": "phpunit"
	}
}
