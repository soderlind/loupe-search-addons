#. Plugin Name of the plugin
#: loupe-search-addons.php
#: includes/Manager.php:48
#: includes/Manager.php:57
msgid "Loupe Search Add-ons"
msgstr "Loupe Search-tillegg"

#. Plugin URI of the plugin
#: loupe-search-addons.php
msgid "https://github.com/soderlind/loupe-search-addons"
msgstr "https://github.com/soderlind/loupe-search-addons"

#. Description of the plugin
#: loupe-search-addons.php
msgid "Install, activate and update Loupe Search add-ons from GitHub. Add-on updates show up in WordPress' own update screens."
msgstr "Installer, aktiver og oppdater tillegg til Loupe Search fra GitHub. Oppdateringer av tilleggene vises i WordPress sine egne oppdateringssider."

#. Author of the plugin
#: loupe-search-addons.php
msgid "Per Soderlind"
msgstr "Per Soderlind"

#. Author URI of the plugin
#: loupe-search-addons.php
msgid "https://soderlind.no"
msgstr "https://soderlind.no"

#: includes/Catalog.php:73
msgid "A search block with instant results as you type, powered by Loupe Search."
msgstr "En søkeblokk som viser treff mens du skriver, drevet av Loupe Search."

#: includes/Catalog.php:74
msgid "Adds meaning-based retrieval to Loupe Search, so visitors find posts that match what they mean, not only the words they type."
msgstr "Legger til betydningsbasert gjenfinning i Loupe Search, slik at besøkende finner innlegg som svarer til det de mener, ikke bare ordene de skriver."

#: includes/Catalog.php:75
msgid "One Loupe Search index per language for sites translated with Polylang or WPML, with stemming and stop words for each language."
msgstr "Én Loupe Search-indeks per språk for nettsteder oversatt med Polylang eller WPML, med ordstammer og stoppord for hvert språk."

#. translators: %d: number of add-ons with an update.
#: includes/Manager.php:39
#, php-format
msgid "Add-ons (%d)"
msgstr "Tillegg (%d)"

#: includes/Manager.php:40
msgid "Add-ons"
msgstr "Tillegg"

#: includes/Manager.php:74
msgid "Manage add-ons"
msgstr "Behandle tillegg"

#: includes/Manager.php:99
msgid "Add-ons extend Loupe Search. They are installed from GitHub, and their updates appear in Dashboard → Updates like any other plugin."
msgstr "Tillegg utvider Loupe Search. De installeres fra GitHub, og oppdateringene deres vises i Kontrollpanel → Oppdateringer som for alle andre utvidelser."

#: includes/Manager.php:100
msgid "Check for updates"
msgstr "Se etter oppdateringer"

#: includes/Manager.php:104
msgid "File changes are disabled on this site (DISALLOW_FILE_MODS), so add-ons cannot be installed, updated or deleted here."
msgstr "Filendringer er slått av på dette nettstedet (DISALLOW_FILE_MODS), så tillegg kan ikke installeres, oppdateres eller slettes her."

